    "proto": "buf generate \"https://github.com/BishopFox/sliver.git#tag=v1.7.3,subdir=protobuf\" --path rpcpb/services.proto --path clientpb/client.proto --path sliverpb/sliver.proto --path commonpb/common.proto",
